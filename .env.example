# Production API secrets
# Copy to: /opt/secrets/dermablaze-api.env
# Permissions: chmod 640 && chown root:mithiles.joshi /opt/secrets/dermablaze-api.env
# Never commit real values to git.

DATABASE_URL="postgresql://dermablaze:YOUR_DB_PASSWORD@localhost:5432/dermablaze_db"
JWT_SECRET="replace-with-a-long-random-secret"
NODE_ENV="production"
PORT=3000
CORS_ORIGIN="https://erp.dermablze.com,https://dermablze.com,https://www.dermablze.com"

# BigQuery (optional — daily sync)
# BQ_PROJECT_ID="your-gcp-project-id"
# GOOGLE_APPLICATION_CREDENTIALS="/opt/secrets/gcp-key.json"
