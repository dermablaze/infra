# Copy this to /opt/dermablaze-api/.env on the server
# Never commit real values to git

# PostgreSQL
DATABASE_URL="postgresql://dermablaze:YOUR_DB_PASSWORD@localhost:5432/dermablaze_db"

# JWT — generate: openssl rand -hex 64
JWT_SECRET="replace-with-a-long-random-secret"

# Environment
NODE_ENV="production"
PORT=3000

# CORS — comma-separated allowed origins
CORS_ORIGIN="https://erp.dermablze.com,https://dermablze.com,https://www.dermablze.com"

# BigQuery (for daily sync script — optional)
BQ_PROJECT_ID="your-gcp-project-id"
GOOGLE_APPLICATION_CREDENTIALS="/opt/dermablaze-api/gcp-key.json"
