# Copy this to /opt/dermablaze-api-test/.env on the server
# Never commit real values to git

# PostgreSQL — test database
DATABASE_URL="postgresql://dermablaze:YOUR_DB_PASSWORD@localhost:5432/dermablaze_db_test"

# JWT — generate: openssl rand -hex 64
JWT_SECRET="replace-with-a-different-secret-from-prod"

# Environment
NODE_ENV="production"
PORT=3001

# CORS
CORS_ORIGIN="https://test-erp.dermablze.com"
